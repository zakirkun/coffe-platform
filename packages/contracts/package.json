{
  "name": "@coffe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST + realtime contracts (zod) shared by apps/api and apps/web",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
