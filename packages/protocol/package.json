{
  "name": "@coffe/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runner <-> control plane protocol: TS types and validators generated from crates/coffe-protocol",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
