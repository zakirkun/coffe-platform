# COFFE control plane (apps/api). Copy to `.env`; `pnpm dev` loads it with --env-file-if-exists.

# development | test | production. Development pretty-prints logs.
NODE_ENV=development

# HTTP port of the API: REST /api/v1, Better Auth /api/auth, WebSockets /api/ws and /api/runner.
PORT=4000

# Postgres (docker compose dev database).
DATABASE_URL=postgres://coffe:coffe@localhost:55432/coffe

# Origin the browser uses (the Next.js app, which proxies /api/* to this server).
PUBLIC_URL=http://localhost:3000

# Server URL printed in the `coffe-runner pair` command; runners connect to it directly.
# Defaults to PUBLIC_URL when unset.
RUNNER_PUBLIC_URL=http://localhost:4000

# Signs session cookies. At least 32 characters; generate one with `openssl rand -base64 32`.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Extra comma-separated browser origins allowed for auth and the realtime socket
# (PUBLIC_URL is always trusted).
TRUSTED_ORIGINS=http://localhost:4000

# Oldest coffe-runner release and protocol minor the control plane accepts; older runners get
# `upgrade_required`.
RUNNER_MIN_VERSION=0.1.0
PROTOCOL_MIN_MINOR=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Apply pending database migrations at startup (true | false).
RUN_MIGRATIONS=true
