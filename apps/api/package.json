{
  "name": "@coffe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "COFFE control plane: NestJS REST + WebSocket gateways, jobs, Drizzle schema",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js",
    "auth:schema": "auth generate --config better-auth.config.ts --output src/db/schema/auth.generated.ts --yes"
  },
  "dependencies": {
    "@coffe/contracts": "workspace:*",
    "@coffe/protocol": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "fractional-indexing": "4.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.3",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "auth": "1.7.25",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
