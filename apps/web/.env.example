# Development only: where `next dev` proxies /api/* (REST + Better Auth).
API_URL=http://localhost:4000

# Browser WebSocket endpoint. Optional: `next dev` derives ws://localhost:4000/api/ws from
# API_URL, production builds default to the page origin (wss://DOMAIN/api/ws).
NEXT_PUBLIC_WS_URL=ws://localhost:4000/api/ws
