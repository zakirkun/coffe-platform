# Public host name. For a local install use coffe.localhost (resolves to 127.0.0.1).
DOMAIN=coffe.localhost
# `internal` = Caddy local CA (local installs); an e-mail address = Let's Encrypt (production).
CADDY_TLS=internal
# openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
POSTGRES_PASSWORD=change-me
LOG_LEVEL=info
# Optional `runner` profile: host directory with repositories to register.
RUNNER_REPOS_DIR=./repos
